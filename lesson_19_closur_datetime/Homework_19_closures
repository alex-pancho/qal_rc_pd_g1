def make_electricity_meter(address: str, initial_kwh: float = 0.0):
    current_kwh = initial_kwh

    def add(kwh: float) -> float:
        nonlocal current_kwh
        current_kwh += kwh
        return current_kwh

    def reset() -> float:
        nonlocal current_kwh
        current_kwh = initial_kwh
        return current_kwh

    def report() -> str:
        return f"Адреса: {address} | Спожито: {current_kwh} кВт·год"

    return add, reset, report

add, reset, report = make_electricity_meter("вул. Академіка Ромоданова, 54а", 150.0)

print(add(30.5))
print(add(14.0))
print(report())
print(reset())
print(report())


