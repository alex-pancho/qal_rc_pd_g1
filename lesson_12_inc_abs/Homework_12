from abc import ABC, abstractmethod


class MagicCreature(ABC):
    def __init__(self, name, magic_level, health, alive=True):
        self.name = name
        self._magic_level = magic_level
        self.__alive = alive
        self.health = health

    @abstractmethod
    def use_ability(self) -> str:
        """Кожен підклас зобов'язаний реалізувати цей метод"""
        pass

    @abstractmethod
    def describe(self) -> str:
        """вертає опис істоти у довільному форматі — кожен підклас описує себе по-своєму"""
        #return f"Мене звати {self.name}, у мене {self._magic_level} магічний рівень, моє здоров'я {self.__health}, я {'живий' if self.__alive else 'мертвий'}."
        pass

    def take_damage(self, amount: int):
        self.health -= amount
        if self.health == 0:
            return f"{self.name} вже переміг смерть... або ні."    
            
        return f"[Здоров'я {self.name} зменшилося на {amount}. Залишилося {self.health}." 

    @property
    def health(self):
        return self.__health


    @health.setter
    def health(self, value):
        if value > 100:
            raise ValueError("Здоров'я не може бути більшим за 100!")

        if value <= 0:
            self.__health = 0
            self.__alive = False
        else:
            self.__health = value
            self.__alive = True

    
    def __str__(self):
        return(
            f"Мене звати {self.name}, " 
            f"у мене {self._magic_level} магічний рівень, " 
            f"моє здоров'я {self.__health}, " 
            f"я {'живий' if self.__alive else 'мертвий'}."
            )
    
    @property
    def magic_level(self):
        return self._magic_level

    @magic_level.setter
    def magic_level(self, level):
        if not 1 <= level <= 10:
            raise ValueError("Рівень магії має бути від 1 до 10!")
        self._magic_level = level

    @property
    def is_alive(self) -> bool:
        return self.__alive


