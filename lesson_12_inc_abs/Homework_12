class Molfar(MagicCreature):
    def __init__(self, name, magic_level, health, alive, element, spells):
        super().__init__(name, magic_level, health, alive)
        self.element = element
        self.spells = spells

    def use_ability(self) -> str:
        if self.__spells > 0:
            self.__spells -= 1
            return (
                f"Мольфар {self.name} закликає стихію {self.element}! "
                f"Залишилось заклинань: {self.__spells}"
            )
        return (
            f"Мольфар {self.name} виснажений — "
            f"сила стихій покинула його!"
        )
  
    def describe(self) -> str:
        return f"Мольфар {self.name}, повелитель стихії {self.element}. Рівень магії: {self._magic_level}"

    @property
    def spells(self):
        return self.__spells
    
    @spells.setter
    def spells(self, value):
        if value < 0:
            raise ValueError("Кількість заклинань не може бути від'ємною!")
        self.__spells = value

class Rusalka(MagicCreature):
    def __init__(self, name, magic_level, health, alive, river, charm_power):
        super().__init__(name, magic_level, health, alive)
        self.river = river
        self.__charm_power = charm_power

    def use_ability(self) -> str:
        if self.__charm_power > 0:
            if self.__charm_power == 5:
                return (
                    f"Русалка {self.name} з річки {self.river} "
                    f"зачаровує мандрівника! "
                    f"Сила чар: {self.__charm_power}. "
                    f"Ніхто не встоїть!"
                )

            return (
                f"Русалка {self.name} з річки {self.river} "
                f"зачаровує мандрівника! "
                f"Сила чар: {self.__charm_power}"
            )

        return f"Русалка {self.name} з річки {self.river} втратила силу чар!"
    
    def describe(self) -> str:
        return f" Русалка {self.name}, мешканка річки {self.river}. Сила чар:{self.charm_power}/5{self.name}." 

    @property
    def charm_power(self):
        return self.charm_power

    @charm_power.setter
    def charm_power(self, value):
        if not 1 <= value <= 5:
            raise ValueError("Сила чар повинна бути від 1 до 5!")
        self.__charm_power = value

class Perelesnyk(MagicCreature):
    def __init__(self, name, magic_level, health, alive, speed, form):
            super().__init__(name, magic_level, health, alive)
            self.speed = speed
            self.form = form
   
    def use_ability(self) -> str:
        if self.form == "людська":
            return (
                f"Перелесник {self.name} мчить крізь ніч "
                f"зі швидкістю {self.__speed}! Форма: {self.form}. "
                f"Ніхто не здогадається, хто він насправді!"
            )
        if self.form == "вогняна куля":
            return (
                f"Перелесник {self.name} мчить крізь ніч "
                f"зі швидкістю {self.__speed}! Форма: {self.form}"
            )
        
    def describe(self) -> str:
        return f"Перелесник {self.name}. Швидкість: {self.__speed}. Зараз у формі: {self.form}" 

    def change_form(self):
        if self.form == "людська":
            self.form = "вогняна куля" 
            return f"Перелесник перетворився на {self.form}!"
        else:
            self.form = "людська" 
            return f"У Перелесника {self.form} форма, ніхто не здогадається де він!"

    @property
    def speed(self):
        return self.__speed
    
    @speed.setter
    def speed(self, value):
            if not 1 <= value <= 100:
                raise ValueError("Швидкість повинна бути від 1 до 100!")
            self.__speed = value




class EnchantedForest:
    def __init__(self, name, creatures = None, capacity = 5):
        self.name = name
        self.creatures = creatures if creatures is not None else []
        self.capacity = capacity
       

    def add_creature(self, creature):
        if len(self.creatures) >= self.capacity:
            return f"Зачарований ліс {self.name} переповнений!"
        
        elif isinstance(creature, Rusalka):
            creature_type = "Русалка"
        elif isinstance(creature, Molfar):
            creature_type = "Мольфар"
        elif isinstance(creature, Perelesnyk):
            creature_type = "Перелесник"
        else:
            creature_type = "Магічна істота" 
        
        if creature in self.creatures:
            return f"{creature.name} вже мешкає у цьому лісі!"

        if not creature.is_alive:
            return f"Мертві істоти не можуть оселитись у лісі!"


        self.creatures.append(creature)
        return f"{creature_type} {creature.name} оселився/оселилася в лісі {self.name}!"
    
    def remove_creature(self, name):
        for creature in self.creatures:
            if creature.name == name:
                self.creatures.remove(creature)
                return f"Істоту {creature.name} було виселено із лісу."
        return f"Істоту {creature.name} не знайдено у лісі!"

    def most_powerful(self):
        if not self.creatures:
            return "Ліс порожній — нема кому чаклувати!"

        return max(self.creatures, key=lambda creature: creature.magic_level)
    
    def attack_intruder(self, intruder_name):
        if not self.creatures:
            return f"Ліс беззахисний перед {intruder_name}!"

        results = []

        for creature in self.creatures:
            if creature.is_alive:
                results.append(creature.use_ability())

        return results

    def census(self):
        if not self.creatures:
            return "Ліс порожній"

        return [creature.describe() for creature in self.creatures]


    @property
    def creatures_count(self):
        return sum(1 for creature in self.creatures if creature.is_alive)

